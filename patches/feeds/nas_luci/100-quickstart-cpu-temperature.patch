+local function get_cpu_temperature()
+  local f = io.open("/sys/class/thermal/thermal_zone0/temp", "r")
+  if not f then
+    return nil
+  end
+
+  local v = f:read("*a")
+  f:close()
+
+  local n = tonumber((v or ""):match("%d+"))
+  if not n then
+    return nil
+  end
+
+  -- thermal_zone0/temp 通常是毫摄氏度，例如 50000 = 50.0
+  if n > 1000 then
+    n = n / 1000
+  end
+
+  -- 返回 JSON number，不带 °C
+  return math.floor(n * 10 + 0.5) / 10
+end
+
+local function is_status_request()
+  local uri = http.getenv("REQUEST_URI") or ""
+  uri = uri:gsub("%?.*$", "")
+  return uri:match("/istore/system/status/?$") ~= nil
+end
+
+local function patch_cpu_temperature(body)
+  if not body or body == "" then
+    return body
+  end
+
+  if body:find('"cpuTemperature"', 1, true) then
+    return body
+  end
+
+  local temp = get_cpu_temperature()
+  if temp == nil then
+    return body
+  end
+
+  local patched, n = body:gsub(
+    '("result"%s*:%s*{)',
+    '%1"cpuTemperature":' .. tostring(temp) .. ',',
+    1
+  )
+
+  if n and n > 0 then
+    return patched
+  end
+
+  return body
+end
+
